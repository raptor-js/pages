{
  "name": "@raptor/pages",
  "version": "0.2.0",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [
      ".github",
      "examples",
      "docs",
      "**/*.test.ts"
    ]
  },
  "tasks": {
    "test": "APP_URL=http://localhost:8000 deno test --coverage=coverage-report --allow-all --parallel",
    "test-coverage": "APP_URL=http://localhost:8000 deno coverage coverage-report"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "lock": true,
  "imports": {
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3.1.1",
    "@raptor/framework": "jsr:@raptor/framework@^0.17.1",
    "@raptor/router": "jsr:@raptor/router@^0.18.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "mdast-util-to-string": "npm:mdast-util-to-string@^4.0.0",
    "preact": "npm:preact@^10.28.4",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.6",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "unified": "npm:unified@^11.0.5",
    "unist-util-visit": "npm:unist-util-visit@^5.1.0",
    "ventojs": "npm:ventojs@^2.3.1"
  }
}
